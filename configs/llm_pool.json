  "_扩容说明": "照着上面的条目复制一份、改 name 和 base_url 即可。全部 20 个副本都开的话，轮询会自动摊平负载",

  "purposes": {
    "rewrite": {
      "models": ["*"],
      "strategy": "round_robin",
      "generation": {"temperature": 0.55, "max_tokens": 512},
      "_说明": "改写答案：要稳，温度低，事实不能漂"
    },
    "paraphrase": {
      "models": ["*"],
      "strategy": "round_robin",
      "generation": {"temperature": 0.95, "top_p": 0.95, "max_tokens": 2048},
      "_说明": "扩写问法：要多样，温度高"
    },
    "judge": {
      "tags": ["judge"],
      "strategy": "failover",
      "generation": {"temperature": 0.0, "max_tokens": 256},
      "_说明": "一致性判定：温度 0 求确定性"
    }
  }
