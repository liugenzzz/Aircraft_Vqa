{
  "version": 1,
  "_说明": "模型池。改完直接重跑，不用动代码。字段说明见 docs/04_llm_pool.md",
  "_密钥": "所有 key 走环境变量，不要写进这个文件（会进 git）。运行前 export LOCAL_LLM_KEY=...",

  "strategy": "round_robin",
  "_strategy说明": "同一模型的多个副本用轮询做负载均衡最合适；若池里是不同档位的模型，改成 weighted 按权重混用",
  "seed": 0,

  "request": {
    "timeout": 120,
    "max_retries": 1,
    "retry_backoff": 1.5,
    "failover": true,
    "_failover说明": "某个副本挂了自动换下一个，不让整批任务失败"
  },

  "generation": {
    "temperature": 0.6,
    "top_p": 0.9,
    "max_tokens": 1024
  },

  "models": [
    {
      "name": "qwen27b-8001",
      "enabled": true,
      "weight": 1,
      "model": "Qwen3.8-27B",
      "base_url": "http://10.107.226.27:8001/v1/chat/completions",
      "api_key_env": "LOCAL_LLM_KEY",
      "tags": ["rewrite", "paraphrase", "judge"],
      "concurrency": 8,
      "timeout": 120
    },
    {
      "name": "qwen27b-8002",
      "enabled": true,
      "weight": 1,
      "model": "Qwen3.8-27B",
      "base_url": "http://10.107.226.27:8002/v1/chat/completions",
      "api_key_env": "LOCAL_LLM_KEY",
      "tags": ["rewrite", "paraphrase", "judge"],
